# Copy this file to .env.local and fill in your Supabase project credentials.
# Never commit .env.local — it is already in .gitignore.

# Node A — first Supabase project
NEXT_PUBLIC_NODE_A_URL=https://<your-node-a-ref>.supabase.co
NEXT_PUBLIC_NODE_A_ANON_KEY=<your-node-a-anon-key>

# Node B — second Supabase project
NEXT_PUBLIC_NODE_B_URL=https://<your-node-b-ref>.supabase.co
NEXT_PUBLIC_NODE_B_ANON_KEY=<your-node-b-anon-key>
